# ==========================================================================
# DEVELOPMENT template — copy to `backend/.env.development` and fill secrets.
# Loaded automatically when APP_ENV=development (the default).
# Runs against LOCAL services from infra/docker-compose.yml (Postgres, Qdrant,
# MinIO). Full annotated reference: docs/CONFIG_REFERENCE.md
# ==========================================================================

# Application
APP_NAME=Multi-Agent AI Analyst API
APP_ENV=development
API_V1_PREFIX=/v1
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:3000

# API security — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local Postgres (infra/docker-compose.yml).
DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst

# Gemini has no local equivalent — use a real key even in development.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local Qdrant (infra/docker-compose.yml). Local Qdrant has no auth; any
# non-empty key is accepted and only keeps /readyz green.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev
QDRANT_COLLECTION=analyst_documents
QDRANT_PREFER_GRPC=false

# Local MinIO (infra/docker-compose.yml) — S3-compatible object storage.
OBJECT_STORAGE_BUCKET=analyst-documents
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin

# Optional — leave blank unless you are exercising these features locally.
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent safety budgets
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false

# No local queue by default.
REDIS_URL=
