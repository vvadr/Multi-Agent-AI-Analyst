# Development only. Copy to `.env.development`; never commit the real file.
# This mode must use local Docker services for all stateful dependencies.

APP_NAME=Multi-Agent AI Analyst API
APP_ENV=development
API_V1_PREFIX=/v1
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUST_PROXY_HEADERS=false

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=multi-agent-ai-analyst
JWT_AUDIENCE=multi-agent-ai-analyst-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITE_EXPIRE_HOURS=168

DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst
# Local demo data only. Production must use a dedicated read-only analytics role.
ANALYTICS_DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match Qdrant collection vectors. Changing this requires a new collection.
EMBEDDING_DIMENSIONS=768

# Optional LiteLLM gateway — OFF by default. Leave LITELLM_BASE_URL blank and
# the backend calls Gemini directly with GEMINI_API_KEY above; that is one
# fewer container and one fewer copy of the key.
# To turn it on: set the URL below, then
#   docker compose -f infra/docker-compose.yml --profile gateway up -d litellm
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
LITELLM_MODEL=flash-lite
LITELLM_EMBEDDING_MODEL=gemini-embedding

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev
QDRANT_COLLECTION=analyst_documents
QDRANT_PREFER_GRPC=false

OBJECT_STORAGE_BUCKET=analyst-documents
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin

TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ENABLE_LANGFUSE_TRACING=false

MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
SERVICE_PROBE_TIMEOUT_SECONDS=3
ENABLE_WEB_SEARCH=false
# Uses the seeded, synthetic analytics.monthly_metrics dataset.
ENABLE_SQL_AGENT=true
ENABLE_CODE_EXECUTION=false
ENABLE_PUBLIC_SIGNUP=true
PUBLIC_APP_URL=http://localhost:3000

# Email is used only for self-service password reset — signing up and signing in
# never send one. "console" prints the reset link to the backend log instead of
# sending it, which is enough to exercise the flow locally.
EMAIL_SENDER=console
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=Multi-Agent AI Analyst

MAX_UPLOAD_BYTES=10000000
MAX_EXTRACTED_CHARACTERS=2000000
MAX_ARCHIVE_MEMBERS=2000
MAX_ARCHIVE_EXPANSION_RATIO=120

# Leave empty to run without Redis: the API then starts an in-process worker
# and an in-memory queue, so the whole product works with one command. Set it
# to run the real queue locally. Production requires it.
REDIS_URL=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_LOGIN_PER_EMAIL_15MIN=5
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_SIGNUP_PER_EMAIL_PER_HOUR=3
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_EMAIL_PER_RECIPIENT_PER_HOUR=3
RATE_LIMIT_REFRESH_PER_15MIN=30
RATE_LIMIT_INVITES_PER_HOUR=30
DAILY_RUN_QUOTA_PER_ORGANIZATION=200
