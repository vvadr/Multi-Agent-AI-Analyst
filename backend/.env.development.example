# Development only. Copy to `.env.development`; never commit the real file.
# This mode must use local Docker services for all stateful dependencies.

APP_NAME=Multi-Agent AI Analyst API
APP_ENV=development
API_V1_PREFIX=/v1
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5432/analyst

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional local LiteLLM gateway. The backend uses this when the URL is set.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=
LITELLM_MODEL=flash-lite
LITELLM_EMBEDDING_MODEL=gemini-embedding

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev
QDRANT_COLLECTION=analyst_documents
QDRANT_PREFER_GRPC=false

OBJECT_STORAGE_BUCKET=analyst-documents
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin

TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
SERVICE_PROBE_TIMEOUT_SECONDS=3
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false

REDIS_URL=

