# ==========================================================================
# PRODUCTION template — CONNECTED services.
# Copy to `backend/.env.production` for a LOCAL production-mode test, OR set
# these as environment variables in the Render dashboard (preferred for the
# real deployment — do not ship a secret file).
# Loaded when APP_ENV=production. Full reference: docs/CONFIG_REFERENCE.md
# ==========================================================================

# Application
APP_NAME=Multi-Agent AI Analyst API
APP_ENV=production
API_V1_PREFIX=/v1
LOG_LEVEL=INFO
# In real production set this to the deployed frontend (Vercel) URL only.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# API security — use a DIFFERENT secret from development.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Hosted Postgres (Neon). Use the +psycopg scheme for SQLAlchemy.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=analyst_documents
QDRANT_PREFER_GRPC=false

# Supabase Storage (S3-compatible)
OBJECT_STORAGE_BUCKET=analyst-documents
OBJECT_STORAGE_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Optional integrations
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent safety budgets
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false

# Optional async-job backend.
REDIS_URL=
