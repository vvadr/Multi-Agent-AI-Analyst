# Production only. Set these in Render; use this file only as a checklist.
# For a local production-mode smoke test, copy it to the ignored `.env.production`.

APP_NAME=Multi-Agent AI Analyst API
APP_ENV=production
API_V1_PREFIX=/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://multi-agent-ai-analyst-psi.vercel.app
# Public API hostname only, without a scheme. Add a custom API domain here if
# you configure one.
ALLOWED_HOSTS=multi-agent-ai-analyst-api.onrender.com
# Render's public service proxy replaces X-Forwarded-For. Keep false for a
# directly reachable app, otherwise callers can forge their rate-limit IP.
TRUST_PROXY_HEADERS=true

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=multi-agent-ai-analyst
JWT_AUDIENCE=multi-agent-ai-analyst-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITE_EXPIRE_HOURS=168
PASSWORD_RESET_EXPIRE_MINUTES=60

# Public self-service registration. Signing up creates a workspace and signs the
# reader straight in — there is no confirmation step, so no email provider is
# needed for the product to work.
ENABLE_PUBLIC_SIGNUP=true
# Origin of the BROWSER app, not the API. Startup refuses a localhost, http, or
# placeholder value.
PUBLIC_APP_URL=https://multi-agent-ai-analyst-psi.vercel.app

# Transactional email is OPTIONAL and used only for self-service password
# reset. Leave EMAIL_SENDER=console and the reset flow is simply unavailable —
# everything else works. To enable it, set EMAIL_SENDER=smtp, fill in the host
# and From address, and set NEXT_PUBLIC_ENABLE_PASSWORD_RESET=true on Vercel.
EMAIL_SENDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Multi-Agent AI Analyst

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Required when ENABLE_SQL_AGENT=true. Use a dedicated read-only analytics role.
ANALYTICS_DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match Qdrant collection vectors. Changing this requires a new collection.
EMBEDDING_DIMENSIONS=768

# Production calls Gemini directly; the local LiteLLM gateway is not deployed.
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
LITELLM_MODEL=flash-lite
LITELLM_EMBEDDING_MODEL=gemini-embedding

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=analyst_documents
QDRANT_PREFER_GRPC=false

OBJECT_STORAGE_BUCKET=analyst-documents
OBJECT_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ENABLE_LANGFUSE_TRACING=false

MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
SERVICE_PROBE_TIMEOUT_SECONDS=3
ENABLE_WEB_SEARCH=false
ENABLE_SQL_AGENT=false
ENABLE_CODE_EXECUTION=false

# Uploads. The byte cap bounds the request; the rest bound what a small upload
# may become once decompressed, since DOCX and XLSX are ZIP containers.
MAX_UPLOAD_BYTES=10000000
MAX_EXTRACTED_CHARACTERS=2000000
MAX_ARCHIVE_MEMBERS=2000
MAX_ARCHIVE_EXPANSION_RATIO=120

# Durable queue. OPTIONAL. Left empty, the API runs an embedded worker in its
# own process — runs and documents are still durable rows and a restart still
# recovers stranded work, but the web tier cannot be scaled past one instance.
REDIS_URL=

# Whether the API process also executes queued jobs.
#
# Unset, this is inferred: on when REDIS_URL is empty, off when it is set
# (because a separate worker service is then the expected topology).
#
# IMPORTANT: if you set REDIS_URL but do NOT deploy the worker service, set
# this to true. Otherwise uploads and questions are queued and nothing ever
# runs them — the API looks healthy while every document stays "Queued".
RUN_EMBEDDED_WORKER=
JOB_MAX_ATTEMPTS=3
JOB_VISIBILITY_TIMEOUT_SECONDS=900
WORKER_POLL_INTERVAL_SECONDS=1

# Abuse controls.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_LOGIN_PER_EMAIL_15MIN=5
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_SIGNUP_PER_EMAIL_PER_HOUR=3
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_EMAIL_PER_RECIPIENT_PER_HOUR=3
RATE_LIMIT_REFRESH_PER_15MIN=30
RATE_LIMIT_INVITES_PER_HOUR=30
RATE_LIMIT_RUNS_PER_HOUR=60
RATE_LIMIT_UPLOADS_PER_HOUR=30
DAILY_RUN_QUOTA_PER_ORGANIZATION=200
