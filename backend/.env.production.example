# Production only. Set these in Render; use this file only as a checklist.
# For a local production-mode smoke test, copy it to the ignored `.env.production`.

APP_NAME=Multi-Agent AI Analyst API
APP_ENV=production
API_V1_PREFIX=/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://your-frontend.vercel.app

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Required when ENABLE_SQL_AGENT=true. Use a dedicated read-only analytics role.
ANALYTICS_DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match Qdrant collection vectors. Changing this requires a new collection.
EMBEDDING_DIMENSIONS=768

# Production calls Gemini directly; the local LiteLLM gateway is not deployed.
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
LITELLM_MODEL=flash-lite
LITELLM_EMBEDDING_MODEL=gemini-embedding

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=analyst_documents
QDRANT_PREFER_GRPC=false

OBJECT_STORAGE_BUCKET=analyst-documents
OBJECT_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
SERVICE_PROBE_TIMEOUT_SECONDS=3
ENABLE_WEB_SEARCH=false
ENABLE_SQL_AGENT=false
ENABLE_CODE_EXECUTION=false
ENABLE_UNAUTHENTICATED_DEMO_API=false
DEMO_TENANT_ID=demo
DEMO_MAX_UPLOAD_BYTES=1000000
DEMO_MAX_CONCURRENT_RUNS=1

REDIS_URL=
