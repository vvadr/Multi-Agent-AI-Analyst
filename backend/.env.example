# Application
APP_NAME=Multi-Agent AI Analyst API
APP_ENV=development
API_V1_PREFIX=/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# API security — generate a unique value before any public deployment.
# PowerShell: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application database — required when database features are implemented.
# Local Docker example: postgresql+psycopg://analyst:analyst@localhost:5432/analyst
# Hosted PostgreSQL example: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Gemini — required for agent answers and embeddings. Keep server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Qdrant — required after document retrieval is enabled.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=analyst_documents
QDRANT_PREFER_GRPC=false

# Object storage — required when persistent document upload is enabled.
# The implementation will use an S3-compatible adapter; keep these blank for now.
OBJECT_STORAGE_BUCKET=analyst-documents
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Optional web search (disabled unless a key is configured).
TAVILY_API_KEY=

# Optional Langfuse tracing. Never trace secrets or raw sensitive documents.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent safety budgets
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=5
RUN_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=5000
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false

# Optional async-job backend. Leave blank until a persistent queue is selected.
REDIS_URL=
