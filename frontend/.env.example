# Frontend public configuration.
#
# ONLY non-secret, browser-safe values belong here. Every variable is exposed
# to the browser via the NEXT_PUBLIC_ prefix. Never place a provider, database,
# JWT, or model key in the frontend — those live only in the backend.
#
# For local development use `.env.development` (committed defaults) or create an
# untracked `.env.local` to override them on your machine.

# Base URL of the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Versioned API prefix — must match the backend API_V1_PREFIX.
NEXT_PUBLIC_API_V1_PREFIX=/v1

# Environment label shown in the UI: development | production
NEXT_PUBLIC_APP_ENV=development
