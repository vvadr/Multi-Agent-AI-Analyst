# Committed defaults for local development (`npm run dev`).
# Loaded automatically by Next.js in the development environment.
# Override locally with an untracked `.env.local` if needed.
#
# ONLY non-secret, browser-safe values belong here. Every NEXT_PUBLIC_ variable
# is shipped to the browser. Never put a provider, database, JWT, or model key
# in the frontend — those live only in the backend.
# Production values: see .env.production.example (set them in Vercel).
# Full reference: ../docs/CONFIG_REFERENCE.md
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/v1
NEXT_PUBLIC_APP_ENV=development
# The local backend uses the console email sender, so the reset link is
# printed to its log rather than sent. Enabled here so the flow is reachable.
NEXT_PUBLIC_ENABLE_ACCOUNT_RECOVERY=true
