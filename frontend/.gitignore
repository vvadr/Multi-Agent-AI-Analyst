# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets and machine-local overrides stay out of Git.
.env
.env.local
.env.*.local
.env.production
# Committed, non-secret env files (only NEXT_PUBLIC_* values):
!.env.example
!.env.development
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
