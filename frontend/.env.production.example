# Template for production values (`npm run build` / `npm run start`, and Vercel).
#
# Do NOT commit the real `.env.production`. Set these in the Vercel project's
# Environment Variables (Production) instead — dashboard values override any
# committed file at build time. Copy this file to `.env.production` only for a
# local production build test.
#
# All values are public (NEXT_PUBLIC_*); there are no secrets on the frontend.
NEXT_PUBLIC_API_BASE_URL=https://multi-agent-ai-analyst-or03.onrender.com
NEXT_PUBLIC_API_V1_PREFIX=/v1
NEXT_PUBLIC_APP_ENV=production

# Shows the "Forgot your password?" link. Only set this to "true" when the
# backend has EMAIL_SENDER=smtp and a working SMTP host — otherwise the link
# leads to an endpoint that answers 503. Registration and sign-in never send
# email, so leaving this off costs nothing else.
NEXT_PUBLIC_ENABLE_ACCOUNT_RECOVERY=false
