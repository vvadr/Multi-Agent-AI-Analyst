# Secrets: keep provider and deployment credentials out of Git.
# Real secrets and machine-local overrides — never commit.
.env
.env.local
.env.*.local
backend/.env
backend/.env.development
backend/.env.production
frontend/.env.production
# Non-secret, committed templates and framework env files are allowed:
#   backend/.env.example, frontend/.env.example,
#   frontend/.env.development, frontend/.env.production.example
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# JavaScript / Next.js
node_modules/
.next/
dist/
coverage/

# Local data and generated artifacts
data/source_docs/
data/uploads/
storage/
qdrant_storage/
*.sqlite
*.db

# Editors and operating systems
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
